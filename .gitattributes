# Normalise line endings in the repository.
* text=auto

# These are consumed by Linux tools (the Actions runner and Apache on the
# host), where a stray CR breaks shell blocks and Apache directives. Pin them
# to LF in the working copy too, not just in the repository.
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf
.htaccess text eol=lf

# Never touch binary assets.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
